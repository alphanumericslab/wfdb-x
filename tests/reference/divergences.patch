+/* file_id gets the identity of the open local file fp; it returns 1 on
+   success, 0 otherwise. */
+static int file_id(FILE *fp, struct file_id *id)
+{
+#ifdef _WIN32
+    BY_HANDLE_FILE_INFORMATION info;
+    HANDLE h = (HANDLE)_get_osfhandle(_fileno(fp));
+
+    if (h == INVALID_HANDLE_VALUE || !GetFileInformationByHandle(h, &info))
