+    id->hi = info.nFileIndexHigh;
+    id->lo = info.nFileIndexLow;
+#else
+    struct stat st;
+
+    if (fstat(fileno(fp), &st) != 0)
+	return (0);
+    id->dev = st.st_dev;
+    id->ino = st.st_ino;
+#endif
